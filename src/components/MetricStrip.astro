---
const metrics = [
  { value: '40%', label: 'offline VIP banking users moved online in three months' },
  { value: '4.3 → 4.7', label: 'NPS improvement' },
  { value: '+475%', label: 'user growth after a product redesign' },
  { value: '0.8% → 2%', label: 'Asroon conversion rate' },
];
---

<div class="metric-strip" aria-label="Selected outcomes">
  {metrics.map((metric, index) => (
    <div class="metric-strip__item">
      <span class="metric-strip__index">0{index + 1}</span>
      <strong>{metric.value}</strong>
      <span>{metric.label}</span>
    </div>
  ))}
</div>
