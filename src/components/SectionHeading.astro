---
interface Props {
  index: string;
  eyebrow: string;
  title: string;
  intro?: string;
}

const { index, eyebrow, title, intro } = Astro.props;
---

<div class="section-heading">
  <p class="section-heading__index">{index}</p>
  <div>
    <p class="eyebrow">{eyebrow}</p>
    <h2>{title}</h2>
    {intro && <p class="section-heading__intro">{intro}</p>}
  </div>
</div>
