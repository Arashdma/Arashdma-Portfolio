---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseCard from '../../components/CaseCard.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import SocialIcon from '../../components/SocialIcon.astro';
import { getCollection } from 'astro:content';
import { faCopy } from '../../data/fa';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const faBase = `${base}fa/`;
const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const translatedWork = faCopy.caseStudies;
---

<BaseLayout
  locale="fa"
  title="آرش دامن‌افشان — مدیر و سازنده‌ی محصول"
  description="پورتفولیوی فارسی آرش دامن‌افشان، مدیر و سازنده‌ی محصول با پیشینه‌ی طراحی محصول."
  languageSwitchHref={base}
>
  <section class="hero page-shell" aria-labelledby="intro-title">
    <div class="hero__center">
      <div class="hero__portrait-frame" data-tilt-target>
        <img class="hero__portrait" src={`${base}images/arash-profile.jpg`} alt="پرتره‌ی آرش دامن‌افشان" width="2685" height="2687" loading="eager" decoding="async" />
      </div>
      <div class="hero__kicker">{faCopy.hero.kicker}</div>
      <h1 id="intro-title">آرش دامن‌افشان</h1>
      <p class="hero__intro">{faCopy.hero.intro}</p>
      <div class="hero__actions">
        <a class="button button--solid" href={`${faBase}#work`}>{faCopy.hero.workCta} <span aria-hidden="true">↘</span></a>
        <a class="text-link" href={`${base}resume/arash-daman-afshan-resume.pdf`} download>{faCopy.hero.cv} <span aria-hidden="true">↓</span></a>
      </div>
    </div>
  </section>

  <section class="page-shell section-block" id="work" aria-labelledby="work-title">
    <SectionHeading index={faCopy.work.index} eyebrow={faCopy.work.eyebrow} title={faCopy.work.title} intro={faCopy.work.intro} />
    <div class="case-grid">
      {work.map((entry) => {
        const translation = translatedWork[entry.data.slug as keyof typeof translatedWork];
        const href = entry.data.mediumUrl || `${base}work/${entry.data.slug}/`;

        return (
          <CaseCard
            href={href}
            title={translation?.title ?? entry.data.title}
            summary={translation?.summary ?? entry.data.summary}
            company={entry.data.company}
            year={entry.data.year}
            kind={entry.data.kind}
            coverImage={entry.data.coverImage}
            labels={faCopy.caseCard}
          />
        );
      })}
    </div>
  </section>

  <section class="about-band section-block" id="experience" aria-labelledby="experience-title">
    <div class="page-shell">
      <SectionHeading index={faCopy.experience.index} eyebrow={faCopy.experience.eyebrow} title={faCopy.experience.title} intro={faCopy.experience.intro} />
      <div class="experience-grid">
        <div class="experience-lede"><p>{faCopy.experience.lede}</p><a class="text-link" href="https://www.linkedin.com/in/arashdma/" target="_blank" rel="noreferrer">{faCopy.experience.linkedin} <span aria-hidden="true">↗</span></a></div>
        <ol class="experience-list">
          <li><span>2026</span><div><strong><a class="experience-company" href="https://zarnet.ir/" target="_blank" rel="noreferrer">ZarNet <span aria-hidden="true">↗</span></a></strong><small>{faCopy.experience.roles.productBuilderManager} · اوت ۲۰۲۶ تا امروز</small></div></li>
          <li><span>2026</span><div><strong>HalaFit</strong><small>{faCopy.experience.roles.productBuilder} · {faCopy.experience.roles.coFounder} · آوریل ۲۰۲۶ تا امروز</small></div></li>
          <li><span>2022</span><div><strong><a class="experience-company" href="https://football360.ir/" target="_blank" rel="noreferrer">Football360 <span aria-hidden="true">↗</span></a></strong><small>{faCopy.experience.roles.seniorProductDesigner} · نوامبر ۲۰۲۲ تا ژوئیه ۲۰۲۶</small></div></li>
          <li class="experience-list__progression">
            <span>2021</span>
            <div>
              <strong><a class="experience-company" href="https://www.sb24.ir/top-clients/top-service/e-banking/ubank" target="_blank" rel="noreferrer">Hamsaa / Ubank <span aria-hidden="true">↗</span></a></strong>
              <small>{faCopy.experience.roles.productTeamLead} · مارس ۲۰۲۵ تا ژوئیه ۲۰۲۶</small>
              <small>{faCopy.experience.roles.seniorProductDesigner} · نوامبر ۲۰۲۱ تا مارس ۲۰۲۵</small>
            </div>
          </li>
          <li><span>2020</span><div><strong><a class="experience-company" href="https://asroon.ir/" target="_blank" rel="noreferrer">Asroon / Ahangar <span aria-hidden="true">↗</span></a></strong><small>{faCopy.experience.roles.productDesigner} · دسامبر ۲۰۲۰ تا فوریه ۲۰۲۲</small></div></li>
          <li><span>2020</span><div><strong>UniPlato</strong><small>{faCopy.experience.roles.productDesigner} · مارس ۲۰۲۰ تا اوت ۲۰۲۱</small></div></li>
          <li><span>2017</span><div><strong>Purple Hachure</strong><small>{faCopy.experience.roles.uiUxDesigner} · فوریه ۲۰۱۷ تا ژانویه ۲۰۲۰</small></div></li>
        </ol>
      </div>
    </div>
  </section>

  <section class="contact-band section-block" id="contact" aria-labelledby="contact-title">
    <div class="page-shell contact-grid">
      <div><p class="eyebrow">{faCopy.contact.eyebrow}</p><h2 id="contact-title">{faCopy.contact.title}</h2></div>
      <div class="contact-copy"><p>{faCopy.contact.copy}</p><a class="button button--light" href="mailto:arashdma@gmail.com">{faCopy.contact.email} <span aria-hidden="true">↗</span></a><div class="contact-links"><a class="social-link" href="https://www.linkedin.com/in/arashdma/" target="_blank" rel="noreferrer" aria-label="LinkedIn"><SocialIcon name="linkedin" /><span>LinkedIn</span></a><a class="social-link" href="https://medium.com/@Arashdma" target="_blank" rel="noreferrer" aria-label="Medium"><SocialIcon name="medium" /><span>Medium</span></a><a class="social-link" href="https://dribbble.com/Arashdma" target="_blank" rel="noreferrer" aria-label="Dribbble"><SocialIcon name="dribbble" /><span>Dribbble</span></a><a href={`${base}resume/arash-daman-afshan-resume.pdf`} download>{faCopy.contact.resume}</a></div></div>
    </div>
  </section>
</BaseLayout>
