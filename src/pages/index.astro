---
import BaseLayout from '../layouts/BaseLayout.astro';
import CaseCard from '../components/CaseCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import SocialIcon from '../components/SocialIcon.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout>
  <section class="hero page-shell" aria-labelledby="intro-title">
    <div class="hero__center">
      <div class="hero__portrait-frame" data-tilt-target>
        <img class="hero__portrait" src={`${base}images/arash-profile.jpg`} alt="Portrait of Arash DamanAfshan" width="2685" height="2687" loading="eager" decoding="async" />
      </div>
      <div class="hero__kicker">Senior Product Designer / Tehran</div>
      <h1 id="intro-title">Arash DamanAfshan</h1>
      <p class="hero__intro">I design digital products that make complex tasks feel clear, intuitive, and easier to act on.</p>
      <div class="hero__actions">
        <a class="button button--solid" href={`${base}#work`}>View selected work <span aria-hidden="true">↘</span></a>
        <a class="text-link" href={`${base}resume/arash-daman-afshan-resume.pdf`} download>Download CV / Resume <span aria-hidden="true">↓</span></a>
      </div>
    </div>
  </section>

  <section class="page-shell section-block" id="work" aria-labelledby="work-title">
      <SectionHeading index="/Work" eyebrow="Selected work" title="Designing clearer digital experiences for complex products and services." intro="Three case studies across service design, e-commerce, and digital entertainment—united by one focus: turning complexity into clarity." />
    <div class="case-grid">
      {work.map((entry) => (
        <CaseCard
          href={entry.data.mediumUrl || `${base}work/${entry.data.slug}/`}
          title={entry.data.title}
          summary={entry.data.summary}
          company={entry.data.company}
          year={entry.data.year}
          kind={entry.data.kind}
          coverImage={entry.data.coverImage}
        />
      ))}
    </div>
  </section>

  <section class="about-band section-block" id="experience" aria-labelledby="experience-title">
    <div class="page-shell">
      <SectionHeading index="/Experience" eyebrow="Professional experience" title="Nine years across industries, connected by a clear design practice." intro="I work across discovery, UX, interaction design, and design systems, partnering closely with teams to turn complex problems into useful product experiences." />
      <div class="experience-grid">
        <div class="experience-lede"><p>I stay close to the problem—from the first unanswered question to the final detail of the interface—and to the people who experience it.</p><a class="text-link" href="https://www.linkedin.com/in/arashdma/" target="_blank" rel="noreferrer">View LinkedIn profile <span aria-hidden="true">↗</span></a></div>
        <ol class="experience-list">
          <li><span>2022</span><div><strong><a class="experience-company" href="https://football360.ir/" target="_blank" rel="noreferrer">Football360 <span aria-hidden="true">↗</span></a></strong><small>Senior Product Designer · Nov 2022 - Present</small></div></li>
          <li class="experience-list__progression">
            <span>2021</span>
            <div>
              <strong><a class="experience-company" href="https://www.sb24.ir/top-clients/top-service/e-banking/ubank" target="_blank" rel="noreferrer">Hamsaa / Ubank <span aria-hidden="true">↗</span></a></strong>
              <small>Product Lead · Mar 2025 - Sep 2026</small>
              <small>Senior Product Designer · Nov 2021 - Mar 2025</small>
            </div>
          </li>
          <li><span>2020</span><div><strong><a class="experience-company" href="https://asroon.ir/" target="_blank" rel="noreferrer">Asroon / Ahangar <span aria-hidden="true">↗</span></a></strong><small>Product Designer · Dec 2020 - Feb 2022</small></div></li>
          <li><span>2020</span><div><strong>UniPlato</strong><small>Product Designer · Mar 2020 - Aug 2021</small></div></li>
          <li><span>2017</span><div><strong>Purple Hachure</strong><small>UI/UX Designer · Feb 2017 - Jan 2020</small></div></li>
        </ol>
      </div>
    </div>
  </section>

  <section class="contact-band section-block" id="contact" aria-labelledby="contact-title">
    <div class="page-shell contact-grid">
      <div><p class="eyebrow">/ Contact</p><h2 id="contact-title">If you believe my experience could support your team or product, I’d be glad to hear from you.</h2></div>
      <div class="contact-copy"><p>I’m open to senior product design opportunities and thoughtful collaborations. Email is the best way to reach me.</p><a class="button button--light" href="mailto:arashdma@gmail.com">Email Arash <span aria-hidden="true">↗</span></a><div class="contact-links"><a class="social-link" href="https://www.linkedin.com/in/arashdma/" target="_blank" rel="noreferrer" aria-label="LinkedIn"><SocialIcon name="linkedin" /><span>LinkedIn</span></a><a class="social-link" href="https://medium.com/@Arashdma" target="_blank" rel="noreferrer" aria-label="Medium"><SocialIcon name="medium" /><span>Medium</span></a><a class="social-link" href="https://dribbble.com/Arashdma" target="_blank" rel="noreferrer" aria-label="Dribbble"><SocialIcon name="dribbble" /><span>Dribbble</span></a><a href={`${base}resume/arash-daman-afshan-resume.pdf`} download>Download resume</a></div></div>
    </div>
  </section>
</BaseLayout>
