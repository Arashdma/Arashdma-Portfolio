---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MotionEnhancer from '../components/MotionEnhancer.astro';
import SectionReveal from '../components/SectionReveal.astro';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  locale?: 'en' | 'fa';
  languageSwitchHref?: string;
}

const {
  locale = 'en',
  languageSwitchHref,
  title,
  description,
  type = 'website',
} = Astro.props;

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const isPersian = locale === 'fa';
const homeHref = isPersian ? `${base}fa/` : base;
const resolvedLanguageSwitchHref = languageSwitchHref ?? (isPersian ? base : `${base}fa/`);
const resolvedTitle = title ?? (isPersian ? 'آرش دامن‌افشان — طراح ارشد محصول' : 'Arash DamanAfshan — Senior Product Designer');
const resolvedDescription = description ?? (isPersian
  ? 'پورتفولیوی آرش دمان‌افشان، طراح ارشد محصول با تمرکز بر کشف محصول، تجربه‌ی کاربری، طراحی تعامل و سیستم‌های طراحی.'
  : 'Portfolio of Arash DamanAfshan, a Senior Product Designer focused on product discovery, UX, interaction design, and design systems.');
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
---

<!doctype html>
<html lang={locale} dir={isPersian ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={resolvedDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta property="og:title" content={resolvedTitle} />
    <meta property="og:description" content={resolvedDescription} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Arash DamanAfshan" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={resolvedTitle} />
    <meta name="twitter:description" content={resolvedDescription} />
    <link rel="alternate" hreflang={isPersian ? 'en' : 'fa'} href={resolvedLanguageSwitchHref} />
    <title>{resolvedTitle}</title>
  </head>
  <body>
    <MotionEnhancer />
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header locale={locale} homeHref={homeHref} languageSwitchHref={resolvedLanguageSwitchHref} />
    <main id="main-content">
      <slot />
    </main>
    <Footer locale={locale} homeHref={homeHref} />
    <SectionReveal />
  </body>
</html>
